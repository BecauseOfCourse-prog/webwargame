{
  "name": "webwargame",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "dev": "pnpm build:packages && pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
