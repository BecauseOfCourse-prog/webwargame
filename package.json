{
  "name": "webwargame",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "env:init": "node scripts/init-local-env.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @webwargame/api db:generate",
    "db:migrate": "pnpm --filter @webwargame/api db:migrate",
    "db:migrate:dev": "pnpm --filter @webwargame/api db:migrate:dev",
    "db:status": "pnpm --filter @webwargame/api db:status",
    "db:verify": "pnpm --filter @webwargame/api db:verify",
    "test:config": "pnpm --filter @webwargame/api test:config",
    "test:database": "pnpm --filter @webwargame/api test:database",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "dev": "pnpm build:packages && pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
