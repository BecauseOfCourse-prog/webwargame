generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  ADMIN
}

// Internal singleton for the last-administrator locking protocol. The migration
// seeds id=1 and enforces its singleton constraint; this is not account content.
model AdministratorGuard {
  id Int @id @default(1)
}

model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username           String   @db.VarChar(32)
  normalizedUsername String   @unique @db.VarChar(32)
  passwordHash       String
  role               UserRole @default(PLAYER)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  sessions           Session[]
}

model Session {
  tokenHash     String   @id @db.Char(64)
  userId        String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime @db.Timestamptz(3)
  idleExpiresAt DateTime @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([idleExpiresAt])
}
