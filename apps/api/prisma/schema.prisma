generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  ADMIN
}

enum AssetOwnerKind {
  UNIT
  MAP
  RULES
}

// Internal singleton for the last-administrator locking protocol. The migration
// seeds id=1 and enforces its singleton constraint; this is not account content.
model AdministratorGuard {
  id Int @id @default(1)
}

model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username           String   @db.VarChar(32)
  normalizedUsername String   @unique @db.VarChar(32)
  passwordHash       String
  role               UserRole @default(PLAYER)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  sessions           Session[]
  assets             Asset[]
}

model Asset {
  id           String   @id @db.Uuid
  uploadedById String   @db.Uuid
  mimeType     String   @db.VarChar(16)
  byteSize     Int
  width        Int
  height       Int
  sha256       String   @db.Char(64)
  ready        Boolean  @default(false)
  archivedAt   DateTime? @db.Timestamptz(3)
  unreferencedSince DateTime? @default(now()) @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  references   AssetReference[]

  @@index([uploadedById])
}

// Internal bindings. Future catalogs must persist their actual owner and these
// bindings in one transaction; this registry does not create catalog content.
model AssetReference {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId   String @db.Uuid
  ownerKind AssetOwnerKind
  ownerId   String @db.Uuid
  slot      String @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([ownerKind, ownerId, slot])
  @@index([assetId])
}

model Session {
  tokenHash     String   @id @db.Char(64)
  userId        String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime @db.Timestamptz(3)
  idleExpiresAt DateTime @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([idleExpiresAt])
}
