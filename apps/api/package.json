{
  "name": "@webwargame/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:generate && nest start --watch",
    "build": "pnpm db:generate && nest build",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:verify": "node scripts/verify-database.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "assets:cleanup": "node scripts/cleanup-assets.mjs",
    "test:config": "node --test test/environment.test.mjs test/startup.test.mjs test/local-database-target.test.mjs",
    "test:registration": "node --test test/registration.test.mjs test/registration-limiter.test.mjs",
    "test:auth": "node --test test/auth.test.mjs test/session-security.test.mjs test/access.test.mjs test/bootstrap-admin.test.mjs",
    "test:assets": "node --test test/image-input.test.mjs test/asset-storage.test.mjs test/asset-activity.test.mjs test/asset-references.test.mjs test/cleanup-assets.test.mjs",
    "test:database": "node --test test/readiness.integration.test.mjs test/registration.integration.test.mjs test/auth.integration.test.mjs test/admin.integration.test.mjs test/assets.integration.test.mjs test/asset-lifecycle.integration.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@webwargame/contracts": "workspace:*",
    "argon2": "0.45.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@types/node": "22.20.5",
    "prisma": "7.10.1"
  }
}
