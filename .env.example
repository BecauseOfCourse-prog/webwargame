# Local development only. Prefer `pnpm env:init` to generate a private .env.
# This example intentionally contains no usable password or connection URL.
POSTGRES_USER=webwargame
POSTGRES_DB=webwargame
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=
API_PORT=3000
# Exact browser origin allowed to use session endpoints; external addresses require HTTPS.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Optional: isolate a second checkout before its first db:up; keep this name stable.
# Also change POSTGRES_PORT and the matching port in your private DATABASE_URL.
# COMPOSE_PROJECT_NAME=webwargame-t04-local
